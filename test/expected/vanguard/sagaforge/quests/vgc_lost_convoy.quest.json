      "type": "dialog",
      "x": 220,
      "y": 60,
      "title": "Offer",
      "speaker": "vgc_reyes",
      "visual": {
        "kind": "person",
        "person": "vgc_reyes"
      },
      "displays": [],
      "conditions": [],
      "script": [],
      "phrases": [],
      "highlights": [
        "Kestrel belt",
        "60,000"
      ],
      "text": "\"$vgc_reyes_title.\" Reyes doesn't look up from her slate. \"One of our convoys went dark near the Kestrel belt eleven days ago. Three freighters, forty crew.\"\n\n\"Find them, and the Compact pays 60,000 credits.\"",
      "options": [
        {
          "id": "accept",
          "text": "Accept the job"
        },
        {
          "id": "catch",
          "text": "\"What's the catch?\"",
          "showOnce": "conversation"
        },
        {
          "id": "double",
          "text": "\"Forty crew is worth more than that.\"",
          "story": {
            "cost": 1
          },
          "showIf": [
            "$global.vgc_lost_convoy_pay == 1"
          ],
          "tooltip": "Use a story point to double the pay."
        },
        {
          "id": "decline",
          "text": "\"Not interested.\"",
          "shortcut": "ESC"
        }
      ]
    },
    {
      "id": "catch",
      "type": "dialog",
      "x": 520,
      "y": 0,
      "title": "Catch",
      "visual": {
        "kind": "keep"
      },
      "displays": [],
      "highlights": [],
      "conditions": [],
      "script": [],
      "phrases": [],
      "text": "\"Pirates, probably. The belt is where they hide.\"",
      "options": [
        {
          "id": "back",
          "text": "Back"
        }
      ]
    },
    {
      "id": "pay2",
