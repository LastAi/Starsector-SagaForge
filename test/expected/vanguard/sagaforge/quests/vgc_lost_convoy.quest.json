      },
      "displays": [],
      "highlights": [],
      "phrases": [],
      "script": [],
      "conditions": [],
      "text": "Reyes turns the black box over in her hands. \"So they didn't make it. But now their families will know why.\"",
      "options": [
        {
          "id": "hand_over",
          "text": "Hand over the black box"
        }
      ]
    },
    {
