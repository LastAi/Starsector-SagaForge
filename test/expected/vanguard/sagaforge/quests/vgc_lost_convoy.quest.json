      "type": "dialog",
      "x": 1220,
      "y": 300,
      "title": "Accepted",
      "speaker": "vgc_reyes",
      "visual": {
        "kind": "keep"
      },
      "displays": [],
      "highlights": [
        "Kestrel belt"
      ],
      "conditions": [],
      "script": [],
      "phrases": [],
      "text": "Reyes nods once. \"The convoy's last position is in your nav computer. Start with the Kestrel belt, and watch for raiders.\"",
      "options": [
        {
          "id": "leave_accepted",
          "text": "\"I'll find them.\""
        }
      ]
    },
    {
      "id": "dock",
