+    case 'quest': return set(m.quests.find((x) => x.id === rest))
+    case 'person': return set(m.people.find((x) => x.id === rest))
+    case 'system': return set(m.systems.find((x) => x.id === rest))
+    case 'entity': return set(m.systems.flatMap((s) => s.entities).find((x) => x.id === rest))
+    case 'encounter': return set(m.encounters.find((x) => x.id === rest))
+    case 'events': return set((m.events ?? []).find((x) => x.id === rest))
+    case 'progress': return set((m.progress ?? []).find((x) => x.id === rest))
+    case 'pool': return set((m.pools ?? []).find((x) => x.id === rest))
+    case 'scatter': return set((m.scatter ?? []).find((x) => x.id === rest))
+    case 'event': { const [s, ev] = rest.split('/'); return set((m.events ?? []).find((x) => x.id === s)?.events.find((x) => x.id === ev)) }
+  }
